<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <DebuggerSupport>false</DebuggerSupport>
    <ApplicationIcon>Resources\Icons\app.ico</ApplicationIcon>
    <!-- Packaging metadata, so the built exe reports the same version as the app shows. The
         number is restated here because MSBuild cannot read the C# constant; the test
         Packaging_metadata_matches_the_app_version fails if the two ever drift apart. -->
    <Version>0.9.7</Version>
    <Product>巫师3 Mod 管理器</Product>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="Resources\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <ItemGroup>
    <Content Include="LICENSE">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    <Content Include="CHANGELOG.md">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
  </ItemGroup>


  <Target Name="RemoveDebugDlls" AfterTargets="Publish">
    <ItemGroup>
      <DebugDlls Include="$(PublishDir)mscordaccore_amd64_amd64_*.dll" />
    </ItemGroup>
    <Delete Files="@(DebugDlls)" />
    <Message Text="Removed debug DLLs: @(DebugDlls)" Importance="high" />
  </Target>
</Project>
