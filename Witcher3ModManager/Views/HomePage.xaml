<UserControl x:Class="Witcher3ModManager.Views.HomePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="72"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2514161E"
                BorderBrush="#1E2230"
                BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Border Grid.Row="0" Height="8"/>

                <StackPanel Grid.Row="1" VerticalAlignment="Center">
                    <Button x:Name="BtnMods" Width="72" Height="56"
                            ToolTip="模组管理" Click="BtnMods_Click"
                            Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xEC7A;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="#C8D0D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="#A0A8B0" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnConflict" Width="72" Height="56"
                            ToolTip="冲突检测" Click="BtnConflict_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xEA3B;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="#C8D0D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="#A0A8B0" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnPresets" Width="72" Height="56"
                            ToolTip="预设配置" Click="BtnPresets_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="#C8D0D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI"
                                                   Foreground="#A0A8B0"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnImport" Width="72" Height="56"
                            ToolTip="导入模组" Click="BtnImport_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="#C8D0D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI" Foreground="#A0A8B0" HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Button x:Name="BtnLaunch" Width="72" Height="56"
                            ToolTip="启动游戏" Click="BtnLaunch_Click" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock Text="&#xE7FC;" FontFamily="Segoe MDL2 Assets"
                                                   FontSize="22" Foreground="#C8D0D8"
                                                   HorizontalAlignment="Center"/>
                                        <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI"
                                                   Foreground="#A0A8B0"
                                                   HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                    </StackPanel>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                        <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                        <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>

                <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                    <!-- Language Toggle -->
                    <Border x:Name="LangToggle" Width="52" Height="28"
                            CornerRadius="14" Background="#1814161E"
                            BorderBrush="#2AFFFFFF" BorderThickness="1"
                            Cursor="Hand" ToolTip="中 / EN"
                            MouseLeftButtonDown="LangToggle_Click"
                            MouseEnter="LangToggle_MouseEnter"
                            MouseLeave="LangToggle_MouseLeave"
                            HorizontalAlignment="Center" Margin="0,0,0,6">
                        <TextBlock x:Name="LangToggleText" Text="中" FontSize="12"
                                   Foreground="#C8D0D8"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   FontFamily="Microsoft YaHei UI"/>
                    </Border>
                    <Border Height="8"/>
                    <Button x:Name="BtnSettings" Width="72" Height="56"
                            ToolTip="设置" Click="BtnSettings_Click" Cursor="Hand" Margin="0,0,0,8">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="Transparent" CornerRadius="4" Margin="6,2">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets"
                                               FontSize="22" Foreground="#C8D0D8"
                                               HorizontalAlignment="Center"/>
                                    <TextBlock Text="{TemplateBinding Content}" FontSize="10" FontFamily="Microsoft YaHei UI"
                                               Foreground="#A0A8B0"
                                               HorizontalAlignment="Center" Margin="0,3,0,0"/>
                                </StackPanel>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#301C1F2A"/>
                                    <Setter TargetName="border" Property="BorderBrush" Value="#558BA4B5"/>
                                    <Setter TargetName="border" Property="BorderThickness" Value="1"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="1" Background="Transparent">
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="&#xED35;" FontFamily="Segoe MDL2 Assets"
                           FontSize="52" Foreground="#8898A4"
                           HorizontalAlignment="Center" Opacity="0.45"/>
                <TextBlock x:Name="WelcomeTitle" Text="巫师3 Mod 管理器" FontSize="30" FontWeight="Light"
                           Foreground="#C8D0D8"
                           HorizontalAlignment="Center" Margin="0,18,0,4"
                           FontFamily="Microsoft YaHei UI"/>
                <TextBlock x:Name="WelcomeSubtitle" Text="选择一个功能开始" FontSize="13"
                           Foreground="#6E7480"
                           HorizontalAlignment="Center"/>
            </StackPanel>

            <Border CornerRadius="4" Padding="8,4"
                    Background="#1814161E" BorderBrush="#1E2230"
                    BorderThickness="1"
                    HorizontalAlignment="Right" VerticalAlignment="Bottom"
                    Margin="0,0,16,16">
                <TextBlock Text="v0.9.1" FontSize="10"
                           Foreground="#5E626E"/>
            </Border>
        </Grid>
    </Grid>
</UserControl>