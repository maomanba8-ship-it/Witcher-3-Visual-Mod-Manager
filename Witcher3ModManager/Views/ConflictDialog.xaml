<Window x:Class="Witcher3ModManager.Views.ConflictDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="冲突检测结果" Width="700" Height="480"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#14161E" CornerRadius="8"
            BorderBrush="#2A2E3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1C1F2A"
                  MouseLeftButtonDown="TitleBar_Drag" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="&#xEA3B;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#C9A96E"
                               Margin="0,0,8,0"/>
                    <TextBlock Text="Mod Manager" FontSize="14" FontWeight="SemiBold"
                               Foreground="#E2E4E9"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;"
                        Click="Close_Click" Margin="0,0,4,0"
                        Width="34" Height="34"
                        Background="Transparent" Foreground="#9A9EAA" BorderThickness="0"
                        FontSize="14" Cursor="Hand" FontFamily="Segoe MDL2 Assets">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#242836"/>
                                    <Setter Property="Foreground" Value="#E2E4E9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="16">
                <StackPanel>
                    <Border Background="#1C1F2A" CornerRadius="6"
                            Padding="14" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock x:Name="SummaryText" FontSize="13"
                                       Foreground="#E2E4E9"
                                       TextWrapping="Wrap"/>
                            <TextBlock x:Name="ScriptWarning" FontSize="12"
                                       Foreground="#C9A96E"
                                       Margin="0,6,0,0" Visibility="Collapsed"
                                       TextWrapping="Wrap"
                                       />
                        </StackPanel>
                    </Border>

                    <!-- Bundle Mod Hint -->
                    <Border x:Name="BundleHintPanel" Visibility="Collapsed"
                            Background="#1A8BA4B5" CornerRadius="6"
                            Padding="14,12" Margin="0,0,0,16"
                            BorderBrush="#338BA4B5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="BundleTitleText" Foreground="#8BA4B5" FontSize="13" FontWeight="SemiBold"
                                       Text="🔵 Bundle Mod(s) Detected"/>
                            <TextBlock x:Name="BundleModListText" Foreground="#C8D0D8"
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="BundleSuggestionText" Foreground="#9A9EAA"
                                       FontSize="12" Margin="0,8,0,0" TextWrapping="Wrap"/>
                        </StackPanel>
                    </Border>

                    <!-- Shared Resource Hint -->
                    <Border x:Name="SharedHintPanel" Visibility="Collapsed"
                            Background="#1A6BA5B5" CornerRadius="6"
                            Padding="14,12" Margin="0,0,0,16"
                            BorderBrush="#336BA5B5" BorderThickness="1">
                        <StackPanel>
                            <TextBlock x:Name="SharedTitleText" Foreground="#6BA5B5" FontSize="13" FontWeight="SemiBold"
                                       Text="🔗 Shared Resources"/>
                            <TextBlock x:Name="SharedModListText" Foreground="#C8D0D8"
                                       FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap"/>
                            <TextBlock x:Name="SharedSuggestionText" Foreground="#9A9EAA"
                                       FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap"
                                       Text="These folders are shared by multiple mods. Disabling one won't remove the shared resource."/>
                        </StackPanel>
                    </Border>
                    <StackPanel x:Name="ConflictStackPanel"/>

                    <StackPanel x:Name="NoConflictsPanel" Visibility="Collapsed"
                                VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,40">
                        <TextBlock Text="&#xE930;" FontFamily="Segoe MDL2 Assets"
                                   FontSize="36" Foreground="#6BAF7B"
                                   HorizontalAlignment="Center"/>
                        <TextBlock x:Name="NoConflictsText" Text="" FontSize="14"
                                   Foreground="#9A9EAA"
                                   HorizontalAlignment="Center" Margin="0,8,0,0"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1C1F2A"
                    Padding="12" BorderBrush="#1E2230" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button x:Name="BtnScriptMerger" Content="脚本合并工具" Width="110"
                            Margin="0,0,10,0" Click="OpenScriptMerger_Click" Visibility="Collapsed"
                            Background="#8BA4B5" Foreground="#14161E" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Padding="16,9" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#A3B8C7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                    <Button x:Name="CloseBtn" Content="" Width="80" Click="Close_Click"
                            Background="#8BA4B5" Foreground="#14161E" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Padding="16,9" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#A3B8C7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>
