<UserControl x:Class="Witcher3ModManager.Views.PresetPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#2014161E"
                BorderBrush="#1E2230"
                BorderThickness="0,0,0,1" Padding="12,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" Width="Auto" Padding="10,6" Click="BackButton_Click"
                        Background="Transparent" Foreground="#9A9EAA" BorderThickness="0"
                        FontSize="14" Cursor="Hand" FontFamily="Segoe MDL2 Assets">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#242836"/>
                                    <Setter Property="Foreground" Value="#E2E4E9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE72B;" FontSize="14"/>
                        <TextBlock Text="杩斿洖" FontSize="13" FontFamily="Microsoft YaHei UI" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
                <TextBlock Grid.Column="1" Text="棰勮绠＄悊" FontSize="15" FontWeight="SemiBold"
                           Foreground="#E2E4E9"
                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                <Button Grid.Column="2" Width="Auto" Padding="12,6" Click="SavePreset_Click"
                        Background="#8BA4B5" Foreground="#14161E" BorderThickness="0"
                        FontSize="13" FontWeight="SemiBold" Cursor="Hand">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#A3B8C7"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE710;" FontFamily="Segoe MDL2 Assets" FontSize="12"/>
                        <TextBlock Text="淇濆瓨褰撳墠閰嶇疆" FontSize="12" FontFamily="Microsoft YaHei UI" Margin="6,0,0,0"/>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="40,20">
            <StackPanel>
                <StackPanel x:Name="EmptyPanel" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,80">
                    <TextBlock Text="&#xE74C;" FontFamily="Segoe MDL2 Assets" FontSize="44"
                               Foreground="#5A6E7C" HorizontalAlignment="Center" Opacity="0.35"/>
                    <TextBlock Text="鏆傛棤棰勮" FontSize="16" FontWeight="Light"
                               Foreground="#9A9EAA" HorizontalAlignment="Center" Margin="0,10,0,4"/>
                    <TextBlock Text="Click Save to create your first preset" FontSize="12"
                               Foreground="#5E626E" HorizontalAlignment="Center"/>
                </StackPanel>

                <StackPanel x:Name="PresetStackPanel"/>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>

