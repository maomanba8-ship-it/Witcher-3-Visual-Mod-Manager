<Window x:Class="Witcher3ModManager.Views.InputDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="InputDialog" Width="420" Height="200"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False">
    <Border Background="#1C1F2A" CornerRadius="10" BorderBrush="#2A2E3C" BorderThickness="1">
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="TitleIcon" Text="&#xE8EC;" FontFamily="Segoe MDL2 Assets"
                           FontSize="18" Foreground="#8BA4B5" Margin="0,0,10,0"/>
                <TextBlock x:Name="TitleText" Text="TITLE" FontSize="15" FontWeight="SemiBold"
                           Foreground="#E2E4E9" VerticalAlignment="Center"/>
            </StackPanel>

            <TextBox x:Name="InputBox" Grid.Row="1" Margin="0,16,0,0" Padding="10,8"
                     Foreground="#E2E4E9" CaretBrush="#E2E4E9"
                     SelectionBrush="#358BA4B5"
                     Background="#14161E" BorderBrush="#2A2E3C"
                     BorderThickness="1" FontSize="14"
                     KeyDown="InputBox_KeyDown"/>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                <Button x:Name="CancelBtn" Content="Cancel" Width="80" Height="32"
                        Foreground="#9A9EAA" Cursor="Hand"
                        Background="Transparent" BorderBrush="#2A2E3C" BorderThickness="1"
                        Click="CancelBtn_Click"/>
                <Button x:Name="ConfirmBtn" Content="Confirm" Width="80" Height="32" Margin="10,0,0,0"
                        Foreground="#E2E4E9" Cursor="Hand"
                        Background="#8BA4B5" BorderThickness="0"
                        Click="ConfirmBtn_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>