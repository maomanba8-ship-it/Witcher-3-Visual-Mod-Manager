<Window x:Class="Witcher3ModManager.Views.PotentialOverlapDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="" Width="550" Height="400"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0"
                      CornerRadius="8" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#14161E" CornerRadius="8"
            BorderBrush="#2A2E3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Background="#1C1F2A"
                  MouseLeftButtonDown="TitleBar_Drag" Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Orientation="Horizontal"
                            VerticalAlignment="Center" Margin="16,0">
                    <TextBlock Text="&#xEA39;" FontFamily="Segoe MDL2 Assets"
                               FontSize="14" Foreground="#C9A96E" Margin="0,0,8,0"/>
                    <TextBlock Text="潜在覆盖" FontSize="14" FontWeight="SemiBold"
                               Foreground="#E2E4E9"/>
                </StackPanel>
                <Button Grid.Column="1" Content="&#xE8BB;" Click="Close_Click"
                        Width="34" Height="34" Margin="0,0,4,0"
                        Background="Transparent" Foreground="#9A9EAA" BorderThickness="0"
                        FontSize="14" Cursor="Hand" FontFamily="Segoe MDL2 Assets">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="border" Background="{TemplateBinding Background}"
                                    CornerRadius="6" Padding="6">
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="border" Property="Background" Value="#242836"/>
                                    <Setter Property="Foreground" Value="#E2E4E9"/>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </Grid>

            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="16">
                <StackPanel>
                    <Border Background="#1C1F2A" CornerRadius="6"
                            Padding="14" Margin="0,0,0,12">
                        <TextBlock x:Name="SummaryText" FontSize="12"
                                   Foreground="#9A9EAA" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel x:Name="OverlapStackPanel"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1C1F2A"
                    Padding="12" BorderBrush="#1E2230" BorderThickness="0,1,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="关闭" Width="80" Click="Close_Click"
                            Background="#8BA4B5" Foreground="#14161E" BorderThickness="0"
                            FontSize="13" FontWeight="SemiBold" Padding="16,9" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="border" Background="{TemplateBinding Background}"
                                        CornerRadius="6" Padding="{TemplateBinding Padding}">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="border" Property="Background" Value="#A3B8C7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>
    </Border>
</Window>