<Window x:Class="Witcher3ModManager.Views.LibraryAuditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="640" Height="540"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False">

    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="0" CornerRadius="10" GlassFrameThickness="0"/>
    </WindowChrome.WindowChrome>

    <Border Background="#14161E" CornerRadius="10"
            BorderBrush="#2A2E3C" BorderThickness="1">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Border Grid.Row="0" Background="#1C1F2A" CornerRadius="10,10,0,0" Padding="16,14">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" FontSize="16" Text="&#xE9D9;"
                                   Foreground="#8BA4B5" VerticalAlignment="Center" Margin="0,0,8,0"/>
                        <TextBlock x:Name="TitleText" FontSize="14" FontWeight="SemiBold"
                                   Foreground="#E2E4E9" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock x:Name="SummaryText" FontSize="12" Foreground="#9A9EAA" Margin="24,6,0,0"
                               TextWrapping="Wrap"/>
                </StackPanel>
            </Border>

            <ScrollViewer Grid.Row="1" Margin="16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Border x:Name="CleanPanel" Visibility="Collapsed"
                            Background="#1A6BAF7B" CornerRadius="6" Padding="14,12"
                            BorderBrush="#336BAF7B" BorderThickness="1">
                        <TextBlock x:Name="CleanText" Foreground="#8FD3A0" FontSize="12" TextWrapping="Wrap"/>
                    </Border>
                    <StackPanel x:Name="ReportStack"/>
                </StackPanel>
            </ScrollViewer>

            <Border Grid.Row="2" Background="#1C1F2A" CornerRadius="0,0,10,10" Padding="16,12">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="NoteText" Grid.Column="0" Foreground="#5E626E" FontSize="11"
                               TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock x:Name="CopyStatusText" Foreground="#6BAF7B" FontSize="11"
                                   VerticalAlignment="Center" Margin="0,0,10,0" Visibility="Collapsed"/>
                        <Button x:Name="CopyBtn" Content="Copy" Width="110" Height="32" Margin="0,0,10,0"
                                Click="CopyBtn_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" Background="Transparent" CornerRadius="6"
                                            BorderBrush="#2A2E3C" BorderThickness="1">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Background" Value="#242836"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button x:Name="CloseBtn" Content="Close" Width="90" Height="32"
                                Click="CloseBtn_Click" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="bd" CornerRadius="6" Background="#8BA4B5">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          TextElement.Foreground="#14161E"
                                                          TextElement.FontWeight="SemiBold"/>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="bd" Property="Opacity" Value="0.85"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
